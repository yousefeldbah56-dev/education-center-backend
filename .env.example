# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/education_center_db

# Security & Authentication Tokens
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_here_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# QR & Attendance Security Tokens
QR_ENCRYPTION_SECRET=your_super_secret_qr_encryption_key_32_chars_min
QR_ROTATION_INTERVAL_SECONDS=30

# AWS S3 Storage (for Videos & PDFs)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET_NAME=education-center-media
